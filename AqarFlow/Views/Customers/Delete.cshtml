@model AqarFlow.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
}

<div class="container mt-5">

    <h1>Delete Customer</h1>
    <p class="text-muted">Delete customer from AqarFlow</p>

    <hr />

    <div class="alert alert-danger">
        Are you sure you want to delete this customer?
    </div>

    <div class="card">
        <div class="card-body">

            <h4>@Model.Name</h4>

            <p>
                <strong>Phone:</strong>
                @Model.Phone
            </p>

            <p>
                <strong>Purpose:</strong>
                @Model.Purpose
            </p>

            <p>
                <strong>Property Type:</strong>
                @Model.PropertyType
            </p>

            <p>
                <strong>Preferred Area:</strong>
                @Model.PreferredArea
            </p>

            <p>
                <strong>Status:</strong>
                @Model.Status
            </p>

            <form asp-controller="Customers"
                  asp-action="DeleteConfirmed"
                  method="post">

                <!-- Customer ID -->
                <input type="hidden" asp-for="Id" />

                <!-- Delete Button -->
                <button type="submit" class="btn btn-danger">
                    Delete
                </button>

                <!-- Cancel Button -->
                <a asp-controller="Customers"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>

