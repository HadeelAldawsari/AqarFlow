<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AqarFlow</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AqarFlow.styles.css" asp-append-version="true" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body>

    <div class="app-wrapper">

        <!-- Sidebar -->
        <aside class="sidebar">

            <!-- Logo -->
            <div class="sidebar-logo">

                <div class="logo-icon">
                    <i class="bi bi-buildings"></i>
                </div>

                <div>
                    <h3>AqarFlow</h3>
                    <span>Real Estate CRM</span>
                </div>

            </div>


            <!-- Navigation -->
            <nav class="sidebar-menu">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="sidebar-link">

                    <i class="bi bi-grid-fill"></i>
                    <span>Dashboard</span>
                </a>


                <a asp-controller="Customers"
                   asp-action="Index"
                   class="sidebar-link">

                    <i class="bi bi-people"></i>
                    <span>Customers</span>
                </a>


                <a href="#"
                   class="sidebar-link">

                    <i class="bi bi-building"></i>
                    <span>Properties</span>
                </a>


                <a href="#"
                   class="sidebar-link">

                    <i class="bi bi-calendar-check"></i>
                    <span>Follow-ups</span>
                </a>


                <a href="#"
                   class="sidebar-link">

                    <i class="bi bi-handshake"></i>
                    <span>Deals</span>
                </a>


                <div class="sidebar-divider"></div>

                <p class="sidebar-section-title">
                    MANAGEMENT
                </p>


                <a asp-controller="Roles"
                   asp-action="Index"
                   class="sidebar-link">

                    <i class="bi bi-person-badge"></i>
                    <span>Roles</span>
                </a>


                <a asp-controller="Permissions"
                   asp-action="Index"
                   class="sidebar-link">

                    <i class="bi bi-shield-lock"></i>
                    <span>Permissions</span>
                </a>


                <div class="sidebar-divider"></div>


                <a href="#"
                   class="sidebar-link">

                    <i class="bi bi-gear"></i>
                    <span>Settings</span>
                </a>

            </nav>


            <!-- Sidebar Footer -->
            <div class="sidebar-footer">
                <p>Great Opportunities.</p>
                <strong>Better Decisions.</strong>
            </div>

        </aside>


        <!-- Main Area -->
        <div class="main-area">

            <!-- Top Bar -->
            <header class="topbar">

                <div>
                    <h4 class="mb-0">
                        Good Morning, Hadeel 👋
                    </h4>

                    <small class="text-muted">
                        Welcome back to AqarFlow
                    </small>
                </div>


                <div class="topbar-right">

                    <div class="search-box">

                        <i class="bi bi-search"></i>

                        <input type="text"
                               placeholder="Search customers, properties..." />

                    </div>


                    <div class="profile-box">

                        <div class="profile-circle">
                            HD
                        </div>

                        <div>
                            <strong>Hadeel</strong>
                            <small>Admin</small>
                        </div>

                    </div>

                </div>

            </header>


            <!-- Page Content -->
            <main class="content-area">

                @RenderBody()

            </main>


            <!-- Footer -->
            <footer class="app-footer">

                <span>
                    AqarFlow - Real Estate CRM
                </span>

                <span>
                    Building better connections • Closing better opportunities
                </span>

            </footer>

        </div>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
