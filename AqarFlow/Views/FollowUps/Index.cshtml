@model IEnumerable<AqarFlow.DTOs.FollowUpDto>

@{
    ViewData["Title"] = "Follow-ups";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">Follow-ups</h2>
            <p class="text-muted mb-0">
                Manage customer follow-ups and scheduled contacts
            </p>
        </div>

        <a asp-controller="FollowUps"
           asp-action="Create"
           class="btn btn-success">

            <i class="bi bi-plus-lg"></i>
            Add Follow-up

        </a>

    </div>


    <!-- Follow-ups Table -->
    <div class="card border-0 shadow-sm">

        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Contact Date</th>
                                <th>Method</th>
                                <th>Result</th>
                                <th>Next Follow-up</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var followUp in Model)
                            {
                                <tr>

                                    <!-- Customer -->
                                    <td>
                                        <strong>
                                            @followUp.CustomerName
                                        </strong>
                                    </td>


                                    <!-- Contact Date -->
                                    <td>
                                        @followUp.ContactDate.ToString("dd MMM yyyy")
                                    </td>


                                    <!-- Contact Method -->
                                    <td>
                                        @(followUp.ContactMethod ?? "-")
                                    </td>


                                    <!-- Result -->
                                    <td>
                                        @(followUp.Result ?? "-")
                                    </td>


                                    <!-- Next Follow-up -->
                                    <td>

                                        @if (followUp.NextFollowUpDate.HasValue)
                                        {
                                            @followUp.NextFollowUpDate.Value.ToString("dd MMM yyyy")
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }

                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (followUp.Status == "Completed")
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else if (followUp.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @followUp.Status
                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->
                                    <td>

                                        <a asp-controller="FollowUps"
                                           asp-action="Edit"
                                           asp-route-id="@followUp.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-pencil"></i>
                                            Edit

                                        </a>

                                        <a asp-controller="FollowUps"
                                           asp-action="Delete"
                                           asp-route-id="@followUp.Id"
                                           class="btn btn-sm btn-outline-danger">

                                            <i class="bi bi-trash"></i>
                                            Delete

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="text-center py-5">

                    <i class="bi bi-calendar-check fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No follow-ups yet
                    </h5>

                    <p class="text-muted">
                        Add your first customer follow-up.
                    </p>

                    <a asp-controller="FollowUps"
                       asp-action="Create"
                       class="btn btn-success">

                        <i class="bi bi-plus-lg"></i>
                        Add Follow-up

                    </a>

                </div>
            }

        </div>

    </div>

</div>