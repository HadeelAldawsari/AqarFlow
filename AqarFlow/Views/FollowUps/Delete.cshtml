@model AqarFlow.Models.FollowUp

@{
    ViewData["Title"] = "Delete Follow-up";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="mb-4">

        <a asp-action="Index"
           class="text-decoration-none">

            <i class="bi bi-arrow-left"></i>
            Back to Follow-ups

        </a>

        <h2 class="mt-3 mb-1">
            Delete Follow-up
        </h2>

        <p class="text-muted">
            Confirm deleting this customer follow-up
        </p>

    </div>


    <!-- Delete Card -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <!-- Warning -->
            <div class="alert alert-danger">

                <i class="bi bi-exclamation-triangle"></i>

                Are you sure you want to delete this follow-up?

            </div>


            <!-- Follow-up Information -->
            <div class="row g-4 mt-1">

                <!-- Customer -->
                <div class="col-md-6">

                    <small class="text-muted">
                        Customer
                    </small>

                    <p class="fw-bold mb-0">
                        @(Model.Customer?.Name ?? "Unknown")
                    </p>

                </div>


                <!-- Contact Date -->
                <div class="col-md-6">

                    <small class="text-muted">
                        Contact Date
                    </small>

                    <p class="fw-bold mb-0">
                        @Model.ContactDate.ToString("dd MMM yyyy")
                    </p>

                </div>


                <!-- Contact Method -->
                <div class="col-md-6">

                    <small class="text-muted">
                        Contact Method
                    </small>

                    <p class="fw-bold mb-0">
                        @(Model.ContactMethod ?? "-")
                    </p>

                </div>


                <!-- Result -->
                <div class="col-md-6">

                    <small class="text-muted">
                        Result
                    </small>

                    <p class="fw-bold mb-0">
                        @(Model.Result ?? "-")
                    </p>

                </div>


                <!-- Next Follow-up -->
                <div class="col-md-6">

                    <small class="text-muted">
                        Next Follow-up
                    </small>

                    <p class="fw-bold mb-0">

                        @if (Model.NextFollowUpDate.HasValue)
                        {
                            @Model.NextFollowUpDate.Value.ToString("dd MMM yyyy")
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </p>

                </div>


                <!-- Status -->
                <div class="col-md-6">

                    <small class="text-muted">
                        Status
                    </small>

                    <p class="fw-bold mb-0">
                        @Model.Status
                    </p>

                </div>


                <!-- Notes -->
                <div class="col-12">

                    <small class="text-muted">
                        Notes
                    </small>

                    <p class="fw-bold mb-0">
                        @(Model.Notes ?? "-")
                    </p>

                </div>

            </div>


            <!-- Delete Form -->
            <form asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post"
                  class="mt-4">

                @Html.AntiForgeryToken()

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash"></i>
                        Delete Follow-up

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>