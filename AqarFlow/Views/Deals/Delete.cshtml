@model AqarFlow.Models.Deal

@{
    ViewData["Title"] = "Delete Deal";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="mb-4">

        <a asp-controller="Deals"
           asp-action="Index"
           class="text-decoration-none">

            <i class="bi bi-arrow-left"></i>
            Back to Deals

        </a>

        <h2 class="mt-3 mb-1">
            Delete Deal
        </h2>

        <p class="text-muted">
            Confirm deleting this real estate deal
        </p>

    </div>


    <!-- Delete Card -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <!-- Warning -->
            <div class="alert alert-danger">

                <i class="bi bi-exclamation-triangle"></i>

                Are you sure you want to delete this deal?

            </div>


            <!-- Deal Information -->
            <div class="row g-4 mt-1">


                <!-- Customer -->
                <div class="col-md-6">

                    <small class="text-muted">
                        Customer
                    </small>

                    <p class="fw-bold mb-0">
                        @(Model.Customer?.Name ?? "Unknown")
                    </p>

                </div>


                <!-- Property -->
                <div class="col-md-6">

                    <small class="text-muted">
                        Property
                    </small>

                    <p class="fw-bold mb-0">
                        @(Model.Property?.Title ?? "Unknown")
                    </p>

                </div>


                <!-- Deal Type -->
                <div class="col-md-6">

                    <small class="text-muted">
                        Deal Type
                    </small>

                    <p class="fw-bold mb-0">
                        @Model.DealType
                    </p>

                </div>


                <!-- Status -->
                <div class="col-md-6">

                    <small class="text-muted">
                        Status
                    </small>

                    <p class="fw-bold mb-0">
                        @Model.Status
                    </p>

                </div>


                <!-- Deal Value -->
                <div class="col-md-6">

                    <small class="text-muted">
                        Deal Value
                    </small>

                    <p class="fw-bold mb-0">

                        @if (Model.DealValue.HasValue)
                        {
                            @Model.DealValue.Value.ToString("N2")
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </p>

                </div>


                <!-- Commission -->
                <div class="col-md-6">

                    <small class="text-muted">
                        Commission
                    </small>

                    <p class="fw-bold mb-0">

                        @if (Model.Commission.HasValue)
                        {
                            @Model.Commission.Value.ToString("N2")
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </p>

                </div>


                <!-- Deal Date -->
                <div class="col-md-6">

                    <small class="text-muted">
                        Deal Date
                    </small>

                    <p class="fw-bold mb-0">

                        @if (Model.DealDate.HasValue)
                        {
                            @Model.DealDate.Value.ToString("dd MMM yyyy")
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </p>

                </div>


                <!-- Notes -->
                <div class="col-12">

                    <small class="text-muted">
                        Notes
                    </small>

                    <p class="fw-bold mb-0">
                        @(Model.Notes ?? "-")
                    </p>

                </div>

            </div>


            <!-- Delete Form -->
            <form asp-controller="Deals"
                  asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post"
                  class="mt-4">

                @Html.AntiForgeryToken()

                <div class="d-flex justify-content-end gap-2">

                    <a asp-controller="Deals"
                       asp-action="Index"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash"></i>
                        Delete Deal

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>