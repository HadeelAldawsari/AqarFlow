@model AqarFlow.Models.Deal

@{
    ViewData["Title"] = "Add Deal";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="mb-4">

        <a asp-controller="Deals"
           asp-action="Index"
           class="text-decoration-none">

            <i class="bi bi-arrow-left"></i>
            Back to Deals

        </a>

        <h2 class="mt-3 mb-1">
            Add Deal
        </h2>

        <p class="text-muted">
            Create a new real estate deal
        </p>

    </div>


    <!-- Form Card -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <form asp-controller="Deals"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- Validation -->
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row g-3">


                    <!-- Customer -->
                    <div class="col-md-6">

                        <label asp-for="CustomerId"
                               class="form-label">
                            Customer
                        </label>

                        <select asp-for="CustomerId"
                                asp-items="ViewBag.Customers"
                                class="form-select">

                            <option value="">
                                Select Customer
                            </option>

                        </select>

                        <span asp-validation-for="CustomerId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Property -->
                    <div class="col-md-6">

                        <label asp-for="PropertyId"
                               class="form-label">
                            Property
                        </label>

                        <select asp-for="PropertyId"
                                asp-items="ViewBag.Properties"
                                class="form-select">

                            <option value="">
                                Select Property
                            </option>

                        </select>

                        <span asp-validation-for="PropertyId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Deal Type -->
                    <div class="col-md-6">

                        <label asp-for="DealType"
                               class="form-label">
                            Deal Type
                        </label>

                        <select asp-for="DealType"
                                class="form-select">

                            <option value="">
                                Select Deal Type
                            </option>

                            <option value="Sale">
                                Sale
                            </option>

                            <option value="Rent">
                                Rent
                            </option>

                        </select>

                        <span asp-validation-for="DealType"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Status -->
                    <div class="col-md-6">

                        <label asp-for="Status"
                               class="form-label">
                            Status
                        </label>

                        <select asp-for="Status"
                                class="form-select">

                            <option value="Open">
                                Open
                            </option>

                            <option value="In Progress">
                                In Progress
                            </option>

                            <option value="Closed">
                                Closed
                            </option>

                            <option value="Cancelled">
                                Cancelled
                            </option>

                        </select>

                    </div>


                    <!-- Deal Value -->
                    <div class="col-md-6">

                        <label asp-for="DealValue"
                               class="form-label">
                            Deal Value
                        </label>

                        <input asp-for="DealValue"
                               type="number"
                               step="0.01"
                               class="form-control"
                               placeholder="Enter deal value" />

                        <span asp-validation-for="DealValue"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Commission -->
                    <div class="col-md-6">

                        <label asp-for="Commission"
                               class="form-label">
                            Commission
                        </label>

                        <input asp-for="Commission"
                               type="number"
                               step="0.01"
                               class="form-control"
                               placeholder="Enter commission amount" />

                        <span asp-validation-for="Commission"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Deal Date -->
                    <div class="col-md-6">

                        <label asp-for="DealDate"
                               class="form-label">
                            Deal Date
                        </label>

                        <input asp-for="DealDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="DealDate"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Notes -->
                    <div class="col-12">

                        <label asp-for="Notes"
                               class="form-label">
                            Notes
                        </label>

                        <textarea asp-for="Notes"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Add any notes about this deal..."></textarea>

                        <span asp-validation-for="Notes"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-controller="Deals"
                       asp-action="Index"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-success">

                        <i class="bi bi-check-lg"></i>
                        Save Deal

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}