@model IEnumerable<AqarFlow.DTOs.CustomerPropertyInterestDto>

@{
    ViewData["Title"] = "Property Matching";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">Property Matching</h2>

            <p class="text-muted mb-0">
                Match customers with suitable properties
            </p>
        </div>

        <a asp-controller="CustomerPropertyInterests"
           asp-action="Create"
           class="btn btn-success">

            <i class="bi bi-plus-lg"></i>
            Add Match

        </a>

    </div>


    <!-- Matching Table -->
    <div class="card border-0 shadow-sm">

        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Property</th>
                                <th>Status</th>
                                <th>Notes</th>
                                <th>Created At</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var interest in Model)
                            {
                                <tr>

                                    <!-- Customer -->
                                    <td>
                                        <strong>
                                            @interest.CustomerName
                                        </strong>
                                    </td>


                                    <!-- Property -->
                                    <td>
                                        @interest.PropertyTitle
                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (interest.Status == "Interested")
                                        {
                                            <span class="badge bg-success">
                                                Interested
                                            </span>
                                        }
                                        else if (interest.Status == "Viewing Scheduled")
                                        {
                                            <span class="badge bg-primary">
                                                Viewing Scheduled
                                            </span>
                                        }
                                        else if (interest.Status == "Not Interested")
                                        {
                                            <span class="badge bg-danger">
                                                Not Interested
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @interest.Status
                                            </span>
                                        }

                                    </td>


                                    <!-- Notes -->
                                    <td>
                                        @(interest.Notes ?? "-")
                                    </td>


                                    <!-- Created At -->
                                    <td>
                                        @interest.CreatedAt.ToString("dd MMM yyyy")
                                    </td>


                                    <!-- Actions -->
                                    <td>

                                        <a asp-controller="CustomerPropertyInterests"
                                           asp-action="Edit"
                                           asp-route-id="@interest.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-pencil"></i>
                                            Edit

                                        </a>

                                        <a asp-controller="CustomerPropertyInterests"
                                           asp-action="Delete"
                                           asp-route-id="@interest.Id"
                                           class="btn btn-sm btn-outline-danger">

                                            <i class="bi bi-trash"></i>
                                            Delete

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="text-center py-5">

                    <i class="bi bi-house-heart fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No property matches yet
                    </h5>

                    <p class="text-muted">
                        Match your first customer with a property.
                    </p>

                    <a asp-controller="CustomerPropertyInterests"
                       asp-action="Create"
                       class="btn btn-success">

                        <i class="bi bi-plus-lg"></i>
                        Add Match

                    </a>

                </div>
            }

        </div>

    </div>

</div>