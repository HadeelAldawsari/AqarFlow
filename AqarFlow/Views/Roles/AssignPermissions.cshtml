@using AqarFlow.Models

@{
    ViewData["Title"] = "Assign Permissions";

    var role = ViewBag.Role as Role;
    var allPermissions = ViewBag.AllPermissions as List<Permission>;
    var assignedPermissionIds = ViewBag.AssignedPermissionIds as List<int>;
}

<div class="container mt-4">

    <h2>Assign Permissions</h2>

    <p class="text-muted">
        Role: <strong>@role?.Name</strong>
    </p>

    <hr />

    <form asp-controller="Roles"
          asp-action="AssignPermissions"
          method="post">

        <input type="hidden"
               name="roleId"
               value="@role?.Id" />

        @if (allPermissions != null && allPermissions.Any())
        {
            @foreach (var permission in allPermissions)
            {
                <div class="form-check mb-2">

                    <input class="form-check-input"
                           type="checkbox"
                           name="permissionIds"
                           value="@permission.Id"
                           id="permission-@permission.Id"
                    @(assignedPermissionIds != null &&
                      assignedPermissionIds.Contains(permission.Id)
                         ? "checked"
                         : "") />

                    <label class="form-check-label"
                           for="permission-@permission.Id">

                        @permission.Name

                    </label>

                </div>
            }
        }
        else
        {
            <div class="alert alert-warning">
                No permissions available.
            </div>
        }

        <div class="mt-4">

            <button type="submit"
                    class="btn btn-primary">
                Save Permissions
            </button>

            <a asp-controller="Roles"
               asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </div>

    </form>

</div>